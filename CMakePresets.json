{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "NS_ENABLE_TESTS": "ON",
        "NS_ENABLE_UI": "ON",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "SMTG_ENABLE_VST3_PLUGIN_EXAMPLES": "OFF",
        "VST3_SDK_ROOT": "$ENV{VST3_SDK_ROOT}",
        "WEBVIEW2_SDK_ROOT": "$env{WEBVIEW2_SDK_ROOT}"
      }
    },
    {
      "name": "win-msvc",
      "displayName": "Windows (MSVC, x64)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "VST3_SDK_ROOT": "$env{VST3_SDK_ROOT}"
      }
    },
    {
      "name": "win-clang",
      "displayName": "Windows (Clang-cl, x64)",
      "inherits": "base",
      "generator": "Visual Studio 18 2026",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "toolset": {
        "value": "ClangCL",
        "strategy": "external"
      },
      "cacheVariables": {
        "VST3_SDK_ROOT": "$env{VST3_SDK_ROOT}"
      }
    },
    {
      "name": "mac-clang",
      "displayName": "macOS (AppleClang)",
      "inherits": "base",
      "generator": "Xcode",
      "cacheVariables": {
        "VST3_SDK_ROOT": "$env{VST3_SDK_ROOT}"
      }
    },
    {
      "name": "linux-gcc",
      "displayName": "Linux (GCC)",
      "inherits": "base",
      "cacheVariables": {
        "VST3_SDK_ROOT": "$env{VST3_SDK_ROOT}"
      }
    },
    {
      "name": "win-analyze",
      "displayName": "Windows (Ninja, clang-tidy analysis only)",
      "generator": "Ninja",
      "inherits": "base",
      "cacheVariables": {
        "VST3_SDK_ROOT": "$env{VST3_SDK_ROOT}",
        "NS_ENABLE_VST3": "OFF",
        "SMTG_ENABLE_VST3_PLUGIN_EXAMPLES": "OFF"
      }
    },
    {
      "name": "win-clangd",
      "displayName": "Windows (Ninja + clang-cl, clangd compile_commands.json)",
      "generator": "Ninja",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-cl",
        "CMAKE_CXX_COMPILER": "clang-cl",
        "NS_ENABLE_VST3": "ON",
        "SMTG_ENABLE_VST3_HOSTING_EXAMPLES": "OFF",
        "VST3_SDK_ROOT": "$env{VST3_SDK_ROOT}"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "win-msvc-debug",
      "configurePreset": "win-msvc",
      "configuration": "Debug"
    },
    {
      "name": "win-msvc-release",
      "configurePreset": "win-msvc",
      "configuration": "Release"
    },
    {
      "name": "mac-clang-debug",
      "configurePreset": "mac-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    }
  ],
  "testPresets": [
    {
      "name": "win-msvc-debug",
      "configurePreset": "win-msvc",
      "configuration": "Debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "mac-clang-debug",
      "configurePreset": "mac-clang",
      "configuration": "Debug"
    },
    {
      "name": "linux-gcc-debug",
      "configurePreset": "linux-gcc",
      "configuration": "Debug"
    }
  ]
}
