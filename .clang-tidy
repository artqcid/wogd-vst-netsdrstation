# clang-tidy configuration for the NetSDRStation VST (CCD "static analysis").
#
# The audio/DSP thread must stay lock-free and allocation-free; the checks
# below target correctness, real-time safety and modern C++ hygiene.

Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  modernize-use-override,
  modernize-use-nullptr,
  readability-identifier-naming,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -clang-analyzer-cplusplus.NewDeleteLeaks

WarningsAsErrors: ''

# Only analyze .cpp files, not headers (headers may reference VST3 SDK)
HeaderFilterRegex: '.*\.cpp$'

# Suppress warnings from system headers
SystemHeaders: false
CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
  # Allow TEST_CASE macro (Catch2) in test files
  - key: readability-identifier-naming.WhitelistIdentifiers
    value: TEST_CASE
