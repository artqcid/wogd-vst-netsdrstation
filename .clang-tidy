# clang-tidy configuration for the NetSDRStation VST (CCD "static analysis").
#
# The audio/DSP thread must stay lock-free and allocation-free; the checks
# below target correctness, real-time safety and modern C++ hygiene.

Checks: >
  clang-diagnostic-*,
  clang-analyzer-*,
  bugprone-*,
  performance-*,
  modernize-use-override,
  modernize-use-nullptr,
  -bugprone-easily-swappable-parameters,
  -bugprone-narrowing-conversions,
  -clang-analyzer-cplusplus.NewDeleteLeaks

WarningsAsErrors: ''

HeaderFilterRegex: 'source/.*'

CheckOptions:
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: camelBack
  - key: readability-identifier-naming.VariableCase
    value: camelBack
  - key: readability-identifier-naming.EnumConstantCase
    value: CamelCase
