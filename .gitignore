*.exe
*.pdb
*.ilk
*.idb
*.iobj
*.ipdb

# Editor / tooling
.vscode/
.idea/
node_modules/
# clangd compile-db symlink -> build/win-msvc/compile_commands.json (machine-local)
compile_commands.json

# Logs / runtime
*.log

# Playwright E2E artifacts (ui/e2e; run only on demand via task "e2e")
ui/test-results/
ui/playwright-report/
ui/playwright/.cache/
